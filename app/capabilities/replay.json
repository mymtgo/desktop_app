{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game-replay",
  "description": "Permissions for the replay window: events, the viewer's fullscreen toggle (F), and the app commands it calls (#389)",
  "windows": [
    "game-replay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-report-ui-error",
    "allow-replay-view",
    "allow-replay-requested-game",
    "allow-replay-share-state",
    "allow-share-replay",
    "allow-revoke-replay"
  ]
}
