table log_events strict=1 without_rowid=0
  column 0 log_file_id INTEGER notnull=1 default=NULL pk=1
  column 1 byte_offset INTEGER notnull=1 default=NULL pk=2
  column 2 kind TEXT notnull=0 default=NULL pk=0
  column 3 match_token TEXT notnull=0 default=NULL pk=0
  column 4 match_id INTEGER notnull=0 default=NULL pk=0
  column 5 game_id INTEGER notnull=0 default=NULL pk=0
  column 6 tournament_token TEXT notnull=0 default=NULL pk=0
  column 7 league_token TEXT notnull=0 default=NULL pk=0
  column 8 league_event_id INTEGER notnull=0 default=NULL pk=0
  column 9 draft_token TEXT notnull=0 default=NULL pk=0
  column 10 logged_at INTEGER notnull=1 default=NULL pk=0
  column 11 raw BLOB notnull=1 default=NULL pk=0
  column 12 compressed INTEGER notnull=1 default=0 pk=0
  column 13 quarantined INTEGER notnull=1 default=0 pk=0
  check (compressed IN (0, 1))
  check (kind IN ('match_state_changed', 'game_state_update', 'deck_used', 'game_management_json', 'match_deck_registered', 'tournament_state_changed', 'tournament_sync', 'tournament_round_info', 'tournament_round_result', 'tournament_player_eliminated', 'tournament_ended', 'draft_created', 'draft_state_changed', 'draft_selection', 'draft_league_standing', 'draft_joined', 'draft_pod_state', 'draft_pack_opened', 'draft_pending_pick', 'draft_ended', 'draft_pick_committed', 'league_pool_granted', 'league_join_request', 'league_joined', 'league_dropped', 'login'))
  check (kind IS NOT NULL OR quarantined = 1)
  check (quarantined IN (0, 1))
  foreign key (log_file_id) -> log_files (id) on update NO ACTION on delete RESTRICT match NONE
  index log_events_draft_token unique=0 origin=c partial=1 on (draft_token): CREATE INDEX log_events_draft_token ON log_events (draft_token) WHERE draft_token IS NOT NULL
  index log_events_drafts unique=0 origin=c partial=1 on (log_file_id, byte_offset): CREATE INDEX log_events_drafts ON log_events (log_file_id, byte_offset) WHERE kind IN ('draft_created', 'draft_state_changed', 'draft_selection', 'draft_league_standing', 'draft_joined', 'draft_pod_state', 'draft_pack_opened', 'draft_pending_pick', 'draft_ended', 'draft_pick_committed', 'league_pool_granted')
  index log_events_frames unique=0 origin=c partial=1 on (game_id, log_file_id, byte_offset): CREATE INDEX log_events_frames ON log_events (game_id, log_file_id, byte_offset) WHERE kind = 'game_state_update'
  index log_events_game_id unique=0 origin=c partial=1 on (game_id): CREATE INDEX log_events_game_id ON log_events (game_id) WHERE game_id IS NOT NULL
  index log_events_joins unique=0 origin=c partial=1 on (match_token): CREATE INDEX log_events_joins ON log_events (match_token) WHERE match_token IS NOT NULL AND kind IN ('game_management_json', 'match_state_changed') AND (compressed = 1 OR instr(raw, 'MatchJoinedEventUnderwayState') > 0)
  index log_events_leagues unique=0 origin=c partial=1 on (log_file_id, byte_offset): CREATE INDEX log_events_leagues ON log_events (log_file_id, byte_offset) WHERE kind IN ('league_joined', 'league_dropped', 'league_join_request')
  index log_events_logins unique=0 origin=c partial=1 on (log_file_id, byte_offset): CREATE INDEX log_events_logins ON log_events (log_file_id, byte_offset) WHERE kind = 'login'
  index log_events_match_id unique=0 origin=c partial=1 on (match_id): CREATE INDEX log_events_match_id ON log_events (match_id) WHERE match_id IS NOT NULL
  index log_events_match_token unique=0 origin=c partial=1 on (match_token): CREATE INDEX log_events_match_token ON log_events (match_token) WHERE match_token IS NOT NULL
  index log_events_registered unique=0 origin=c partial=1 on (match_token, log_file_id, byte_offset): CREATE INDEX log_events_registered ON log_events (match_token, log_file_id, byte_offset) WHERE kind = 'match_deck_registered'
  index log_events_tournament_kinds unique=0 origin=c partial=1 on (log_file_id, byte_offset): CREATE INDEX log_events_tournament_kinds ON log_events (log_file_id, byte_offset) WHERE kind IN ('tournament_sync', 'tournament_state_changed', 'tournament_round_result', 'tournament_round_info', 'tournament_player_eliminated', 'tournament_ended')
  index log_events_tournament_state_changes unique=0 origin=c partial=1 on (logged_at): CREATE INDEX log_events_tournament_state_changes ON log_events (logged_at) WHERE kind = 'tournament_state_changed'
  index log_events_tournament_token unique=0 origin=c partial=1 on (tournament_token): CREATE INDEX log_events_tournament_token ON log_events (tournament_token) WHERE tournament_token IS NOT NULL
  index sqlite_autoindex_log_events_1 unique=1 origin=pk partial=0 on (log_file_id, byte_offset)
table log_files strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 path TEXT notnull=1 default=NULL pk=0
  column 2 identity_hash TEXT notnull=1 default=NULL pk=0
  column 3 head_hash TEXT notnull=1 default=NULL pk=0
  column 4 head_len INTEGER notnull=1 default=NULL pk=0
  column 5 created_at_fs INTEGER notnull=0 default=NULL pk=0
  column 6 anchor_offset INTEGER notnull=0 default=NULL pk=0
  column 7 anchor_hash TEXT notnull=0 default=NULL pk=0
  column 8 day_anchor TEXT notnull=1 default=NULL pk=0
  column 9 timezone TEXT notnull=1 default=NULL pk=0
  column 10 inherited_username TEXT notnull=0 default=NULL pk=0
  column 11 local_username TEXT notnull=0 default=NULL pk=0
  column 12 local_login_id INTEGER notnull=0 default=NULL pk=0
  column 13 cursor_offset INTEGER notnull=1 default=0 pk=0
  column 14 clock_date TEXT notnull=1 default=NULL pk=0
  column 15 clock_last_secs INTEGER notnull=0 default=NULL pk=0
  column 16 last_observed_size INTEGER notnull=1 default=0 pk=0
  column 17 stuck_ticks INTEGER notnull=1 default=0 pk=0
  column 18 first_seen_at INTEGER notnull=1 default=NULL pk=0
  column 19 last_seen_at INTEGER notnull=1 default=NULL pk=0
  column 20 sealed_at INTEGER notnull=0 default=NULL pk=0
  column 21 seal_reason TEXT notnull=0 default=NULL pk=0
  check ((sealed_at IS NULL) = (seal_reason IS NULL))
  check (seal_reason IN ('truncated', 'created_forward', 'head_changed', 'anchor_changed', 'stuck_force_reset'))
  index log_files_one_active_per_path unique=1 origin=c partial=1 on (path): CREATE UNIQUE INDEX log_files_one_active_per_path ON log_files (path) WHERE sealed_at IS NULL
table match_archetypes strict=1 without_rowid=0
  column 0 match_id INTEGER notnull=1 default=NULL pk=1
  column 1 is_opponent INTEGER notnull=1 default=NULL pk=2
  column 2 archetype_id INTEGER notnull=1 default=NULL pk=0
  column 3 confidence REAL notnull=1 default=NULL pk=0
  column 4 manual INTEGER notnull=1 default=0 pk=0
  check (confidence >= 0 AND confidence <= 1)
  check (is_opponent IN (0, 1))
  check (manual IN (0, 1))
  foreign key (archetype_id) -> archetypes (id) on update NO ACTION on delete CASCADE match NONE
