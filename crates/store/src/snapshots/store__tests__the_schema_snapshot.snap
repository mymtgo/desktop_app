---
source: crates/store/src/lib.rs
expression: schema_description(&conn)
---
table accounts strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 username TEXT notnull=1 default=NULL pk=0
  column 2 login_id INTEGER notnull=0 default=NULL pk=0
  column 3 first_seen_at INTEGER notnull=1 default=NULL pk=0
  column 4 tracked INTEGER notnull=1 default=1 pk=0
  column 5 tracked_chosen INTEGER notnull=1 default=0 pk=0
  column 6 last_login_at INTEGER notnull=0 default=NULL pk=0
  column 7 platform TEXT notnull=1 default='mtgo' pk=0
  column 8 arena_user_id TEXT notnull=0 default=NULL pk=0
  column 9 display_name TEXT notnull=0 default=NULL pk=0
  check (platform IN ('mtgo', 'arena', 'endstep'))
  check (tracked IN (0, 1))
  check (tracked_chosen IN (0, 1))
  index accounts_arena_user_id unique=1 origin=c partial=1 on (arena_user_id): CREATE UNIQUE INDEX accounts_arena_user_id ON accounts (arena_user_id) WHERE arena_user_id IS NOT NULL
  index sqlite_autoindex_accounts_1 unique=1 origin=u partial=0 on (username)
  index sqlite_autoindex_accounts_2 unique=1 origin=u partial=0 on (login_id)
table archetype_cards strict=1 without_rowid=0
  column 0 archetype_id INTEGER notnull=1 default=NULL pk=1
  column 1 list INTEGER notnull=1 default=NULL pk=2
  column 2 catalog_id INTEGER notnull=1 default=NULL pk=3
  column 3 oracle_id TEXT notnull=0 default=NULL pk=0
  column 4 quantity INTEGER notnull=1 default=NULL pk=0
  column 5 sideboard INTEGER notnull=1 default=NULL pk=4
  check (list >= 1)
  check (quantity >= 1)
  check (sideboard IN (0, 1))
  foreign key (archetype_id) -> archetypes (id) on update NO ACTION on delete CASCADE match NONE
  index archetype_cards_catalog_id unique=0 origin=c partial=0 on (catalog_id): CREATE INDEX archetype_cards_catalog_id ON archetype_cards (catalog_id)
  index sqlite_autoindex_archetype_cards_1 unique=1 origin=pk partial=0 on (archetype_id, list, catalog_id, sideboard)
table archetypes strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 uuid TEXT notnull=1 default=NULL pk=0
  column 2 name TEXT notnull=1 default=NULL pk=0
  column 3 format TEXT notnull=0 default=NULL pk=0
  column 4 color_identity TEXT notnull=0 default=NULL pk=0
  column 5 source TEXT notnull=1 default=NULL pk=0
  column 6 definition TEXT notnull=0 default=NULL pk=0
  column 7 definition_version TEXT notnull=0 default=NULL pk=0
  column 8 retired_at INTEGER notnull=0 default=NULL pk=0
  column 9 merged_into_id INTEGER notnull=0 default=NULL pk=0
  column 10 source_match_id INTEGER notnull=0 default=NULL pk=0
  column 11 incomplete INTEGER notnull=1 default=0 pk=0
  column 12 created_at INTEGER notnull=1 default=NULL pk=0
  column 13 updated_at INTEGER notnull=1 default=NULL pk=0
  column 14 offline_held INTEGER notnull=1 default=0 pk=0
  check ((source = 'fallback') = (format IS NULL))
  check (definition IS NULL OR json_valid(definition))
  check (incomplete IN (0, 1))
  check (merged_into_id IS NULL OR merged_into_id <> id)
  check (offline_held IN (0, 1))
  check (source = 'downloaded' OR definition IS NULL)
  check (source IN ('downloaded', 'manual', 'fallback', 'commander'))
  foreign key (merged_into_id) -> archetypes (id) on update NO ACTION on delete SET NULL match NONE
  foreign key (source_match_id) -> matches (id) on update NO ACTION on delete SET NULL match NONE
  index archetypes_format unique=0 origin=c partial=0 on (format, name): CREATE INDEX archetypes_format ON archetypes (format, name)
  index sqlite_autoindex_archetypes_1 unique=1 origin=u partial=0 on (uuid)
