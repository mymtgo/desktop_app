  column 3 catalog_id INTEGER notnull=1 default=NULL pk=0
  check (position IN (0, 1))
  check (seat IN ('player', 'opponent'))
  foreign key (match_id) -> matches (id) on update NO ACTION on delete CASCADE match NONE
