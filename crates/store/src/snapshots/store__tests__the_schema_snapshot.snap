  check (source IN ('registered', 'imported'))
  foreign key (match_id) -> matches (id) on update NO ACTION on delete CASCADE match NONE
  index sqlite_autoindex_limited_deck_snapshots_1 unique=1 origin=pk partial=0 on (match_id, source)
