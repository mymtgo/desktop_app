  column 22 battlefield_seen INTEGER notnull=1 default=0 pk=0
  column 23 has_zone_data INTEGER notnull=1 default=0 pk=0
  column 24 inferred INTEGER notnull=1 default=0 pk=0
  check (has_zone_data IN (0, 1))
  check (inferred IN (0, 1))
  check (side IN ('local', 'opponent'))
  check (starting_hand = opening_hand - bottomed)
  foreign key (game_id) -> games (id) on update NO ACTION on delete CASCADE match NONE
