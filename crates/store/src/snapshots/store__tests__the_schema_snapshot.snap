  index match_archetypes_archetype_id unique=0 origin=c partial=0 on (archetype_id, is_opponent): CREATE INDEX match_archetypes_archetype_id ON match_archetypes (archetype_id, is_opponent)
  index sqlite_autoindex_match_archetypes_1 unique=1 origin=pk partial=0 on (match_id, is_opponent)
