table tournament_rounds strict=1 without_rowid=0
  column 0 account_id INTEGER notnull=1 default=NULL pk=1
  column 1 mtgo_event_id INTEGER notnull=1 default=NULL pk=2
  column 2 round INTEGER notnull=1 default=NULL pk=3
  column 3 bye_count INTEGER notnull=1 default=0 pk=0
  column 4 match_tokens TEXT notnull=1 default='[]' pk=0
  column 5 account_match_token TEXT notnull=0 default=NULL pk=0
  column 6 account_bye INTEGER notnull=1 default=0 pk=0
  column 7 started_at INTEGER notnull=0 default=NULL pk=0
  column 8 match_minutes INTEGER notnull=0 default=NULL pk=0
  column 9 paired_file_id INTEGER notnull=1 default=NULL pk=0
  column 10 paired_offset INTEGER notnull=1 default=NULL pk=0
  column 11 paired_at INTEGER notnull=1 default=NULL pk=0
  check (account_bye IN (0, 1))
  check (round >= 1)
  foreign key (account_id) -> accounts (id) on update NO ACTION on delete CASCADE match NONE
  index sqlite_autoindex_tournament_rounds_1 unique=1 origin=pk partial=0 on (account_id, mtgo_event_id, round)
table tournament_standings strict=1 without_rowid=0
  column 0 account_id INTEGER notnull=1 default=NULL pk=1
  column 1 mtgo_event_id INTEGER notnull=1 default=NULL pk=2
  column 2 token TEXT notnull=1 default=NULL pk=0
  column 3 name TEXT notnull=0 default=NULL pk=0
  column 4 format TEXT notnull=0 default=NULL pk=0
  column 5 cut_size INTEGER notnull=0 default=NULL pk=0
  column 6 swiss_rounds INTEGER notnull=0 default=NULL pk=0
  column 7 round_minutes INTEGER notnull=0 default=NULL pk=0
  column 8 starts_at INTEGER notnull=0 default=NULL pk=0
  column 9 status TEXT notnull=1 default=NULL pk=0
  column 10 round INTEGER notnull=0 default=NULL pk=0
  column 11 stage TEXT notnull=1 default=NULL pk=0
  column 12 in_playoffs INTEGER notnull=1 default=0 pk=0
  column 13 round_started_at INTEGER notnull=0 default=NULL pk=0
  column 14 round_result_at INTEGER notnull=0 default=NULL pk=0
  column 15 rank INTEGER notnull=0 default=NULL pk=0
  column 16 players INTEGER notnull=0 default=NULL pk=0
  column 17 matches_left INTEGER notnull=0 default=NULL pk=0
  column 18 byes INTEGER notnull=1 default=0 pk=0
  column 19 finish TEXT notnull=0 default=NULL pk=0
  column 20 place INTEGER notnull=0 default=NULL pk=0
  column 21 finished_at INTEGER notnull=0 default=NULL pk=0
  column 22 last_transition_at INTEGER notnull=1 default=NULL pk=0
  column 23 last_event_at INTEGER notnull=1 default=NULL pk=0
  column 24 rounds_read_file_id INTEGER notnull=0 default=NULL pk=0
  column 25 rounds_read_offset INTEGER notnull=0 default=NULL pk=0
  column 26 rounds_login_id INTEGER notnull=0 default=NULL pk=0
  check ((rounds_read_file_id IS NULL) = (rounds_read_offset IS NULL))
  check ((status = 'finished') = (finish IS NOT NULL))
  check (finish IN ('trophied', 'top_cut', 'missed_cut', 'complete', 'dropped', 'eliminated'))
  check (in_playoffs IN (0, 1))
  check (stage IN ('swiss', 'top8', 'semifinal', 'final'))
  check (status IN ('registered', 'playing', 'waiting_for_round', 'bye', 'made_cut', 'finished'))
  foreign key (account_id) -> accounts (id) on update NO ACTION on delete CASCADE match NONE
  index sqlite_autoindex_tournament_standings_1 unique=1 origin=pk partial=0 on (account_id, mtgo_event_id)
