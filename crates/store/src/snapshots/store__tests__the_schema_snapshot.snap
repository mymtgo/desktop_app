table leagues strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 run_key TEXT notnull=1 default=NULL pk=0
  column 2 account_id INTEGER notnull=0 default=NULL pk=0
  column 3 source TEXT notnull=1 default=NULL pk=0
  column 4 kind TEXT notnull=1 default=NULL pk=0
  column 5 state TEXT notnull=1 default=NULL pk=0
  column 6 token TEXT notnull=0 default=NULL pk=0
  column 7 event_id INTEGER notnull=0 default=NULL pk=0
  column 8 mtgo_course_id INTEGER notnull=0 default=NULL pk=0
  column 9 name TEXT notnull=1 default=NULL pk=0
  column 10 format TEXT notnull=0 default=NULL pk=0
  column 11 set_code TEXT notnull=0 default=NULL pk=0
  column 12 deck_version_id INTEGER notnull=0 default=NULL pk=0
  column 13 deck_id INTEGER notnull=0 default=NULL pk=0
  column 14 started_at INTEGER notnull=1 default=NULL pk=0
  column 15 joined_at INTEGER notnull=0 default=NULL pk=0
  column 16 completed_at INTEGER notnull=0 default=NULL pk=0
  column 17 dropped_at INTEGER notnull=0 default=NULL pk=0
  column 18 created_at INTEGER notnull=1 default=NULL pk=0
  column 19 detached_at INTEGER notnull=0 default=NULL pk=0
  column 20 user_dropped_at INTEGER notnull=0 default=NULL pk=0
  column 21 notes TEXT notnull=0 default=NULL pk=0
  column 22 notes_edited_at INTEGER notnull=0 default=NULL pk=0
  column 23 imported_from INTEGER notnull=0 default=NULL pk=0
  column 24 imported_seed TEXT notnull=0 default=NULL pk=0
  column 25 removed_at INTEGER notnull=0 default=NULL pk=0
  column 26 user_state TEXT notnull=0 default=NULL pk=0
  column 27 edited_at INTEGER notnull=0 default=NULL pk=0
  column 28 sync_client_id TEXT notnull=0 default=NULL pk=0
  column 29 rounds INTEGER notnull=0 default=NULL pk=0
  column 30 course_wins INTEGER notnull=0 default=NULL pk=0
  column 31 course_losses INTEGER notnull=0 default=NULL pk=0
  column 32 course_observed_at INTEGER notnull=0 default=NULL pk=0
  check ((source = 'imported') = (imported_seed IS NOT NULL))
  check (imported_seed IS NULL OR json_valid(imported_seed))
  check (kind IN ('constructed', 'draft', 'sealed'))
  check (notes IS NULL OR length(notes) BETWEEN 1 AND 5000)
  check (rounds IS NULL OR rounds > 0)
  check (source <> 'imported' OR run_key = '0x:' || imported_from)
  check (source <> 'log' OR (token IS NOT NULL AND imported_from IS NULL))
  check (source <> 'manual' OR (run_key LIKE 'manual:%' AND kind = 'constructed' AND state = 'complete' AND token IS NOT NULL AND substr(token, 1, 7) = 'manual_'))
  check (source IN ('log', 'imported', 'manual'))
  check (state IN ('active', 'complete', 'partial', 'dropped'))
  check (user_state IS NULL OR user_state IN ('active', 'complete', 'partial', 'dropped'))
  foreign key (account_id) -> accounts (id) on update NO ACTION on delete RESTRICT match NONE
  foreign key (deck_id) -> decks (id) on update NO ACTION on delete RESTRICT match NONE
  foreign key (deck_version_id) -> deck_versions (id) on update NO ACTION on delete SET NULL match NONE
  index leagues_account_kind unique=0 origin=c partial=0 on (account_id, kind, started_at): CREATE INDEX leagues_account_kind ON leagues (account_id, kind, started_at)
  index leagues_deck_id unique=0 origin=c partial=1 on (deck_id): CREATE INDEX leagues_deck_id ON leagues (deck_id) WHERE deck_id IS NOT NULL
  index leagues_deck_version_id unique=0 origin=c partial=1 on (deck_version_id): CREATE INDEX leagues_deck_version_id ON leagues (deck_version_id) WHERE deck_version_id IS NOT NULL
  index leagues_sync_client_id unique=0 origin=c partial=0 on (sync_client_id): CREATE INDEX leagues_sync_client_id ON leagues (sync_client_id)
  index sqlite_autoindex_leagues_1 unique=1 origin=u partial=0 on (run_key)
  index sqlite_autoindex_leagues_2 unique=1 origin=u partial=0 on (imported_from)
trigger leagues_client_id_changed_requeues_reports: CREATE TRIGGER leagues_client_id_changed_requeues_reports AFTER UPDATE OF sync_client_id ON leagues WHEN OLD.sync_client_id IS NOT NEW.sync_client_id BEGIN DELETE FROM outbox WHERE kind = 'match_report' AND (status <> 'sent' OR attempts > 0) AND subject IN (SELECT token FROM matches WHERE league_id = NEW.id AND hidden_at IS NULL); END
trigger leagues_inserted_fills_sync_client_id: CREATE TRIGGER leagues_inserted_fills_sync_client_id AFTER INSERT ON leagues WHEN NEW.sync_client_id IS NULL AND NEW.token IS NOT NULL AND NEW.run_key NOT LIKE 'arena:%' BEGIN UPDATE leagues SET sync_client_id = NEW.token || '_' || strftime('%Y%m%dT%H%M%SZ', (NEW.started_at - (NEW.started_at % 1000 + 1000) % 1000) / 1000, 'unixepoch') WHERE id = NEW.id; END
trigger leagues_token_set_fills_sync_client_id: CREATE TRIGGER leagues_token_set_fills_sync_client_id AFTER UPDATE OF token ON leagues WHEN NEW.sync_client_id IS NULL AND NEW.token IS NOT NULL AND NEW.run_key NOT LIKE 'arena:%' BEGIN UPDATE leagues SET sync_client_id = NEW.token || '_' || strftime('%Y%m%dT%H%M%SZ', (NEW.started_at - (NEW.started_at % 1000 + 1000) % 1000) / 1000, 'unixepoch') WHERE id = NEW.id; END
table limited_deck_snapshots strict=1 without_rowid=0
  column 0 match_id INTEGER notnull=1 default=NULL pk=1
