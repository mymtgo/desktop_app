view match_rank_readings: CREATE VIEW match_rank_readings AS SELECT m.id AS match_id, r.arena_log_file_id AS rank_file_id, r.byte_offset AS rank_byte_offset FROM matches m JOIN accounts a ON a.id = m.account_id AND a.platform = 'arena' LEFT JOIN arena_log_events f ON f.rowid = (SELECT e.rowid FROM arena_log_events e WHERE e.match_token = m.token ORDER BY e.arena_log_file_id, e.byte_offset LIMIT 1) JOIN arena_rank_observations r ON r.rowid = (SELECT o.rowid FROM arena_rank_observations o WHERE o.account_id = m.account_id AND o.ladder = 'constructed' AND CASE WHEN m.source = 'manual' THEN o.observed_at < m.started_at ELSE (o.arena_log_file_id, o.byte_offset) < (f.arena_log_file_id, f.byte_offset) END ORDER BY o.season DESC, o.arena_log_file_id DESC, o.byte_offset DESC LIMIT 1) WHERE m.match_type = 'ranked'
  column 0 match_id INTEGER notnull=0 default=NULL pk=0
  column 1 rank_file_id INTEGER notnull=0 default=NULL pk=0
  column 2 rank_byte_offset INTEGER notnull=0 default=NULL pk=0
table matches strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 token TEXT notnull=1 default=NULL pk=0
  column 2 mtgo_match_id INTEGER notnull=0 default=NULL pk=0
  column 3 account_id INTEGER notnull=1 default=NULL pk=0
  column 4 opponent_id INTEGER notnull=0 default=NULL pk=0
  column 5 source TEXT notnull=1 default=NULL pk=0
  column 6 format TEXT notnull=0 default=NULL pk=0
  column 7 match_type TEXT notnull=0 default=NULL pk=0
  column 8 tournament_event_id INTEGER notnull=0 default=NULL pk=0
  column 9 tournament_round INTEGER notnull=0 default=NULL pk=0
  column 10 state TEXT notnull=1 default=NULL pk=0
  column 11 outcome TEXT notnull=1 default=NULL pk=0
  column 12 started_at INTEGER notnull=1 default=NULL pk=0
  column 13 ended_at INTEGER notnull=0 default=NULL pk=0
  column 14 last_activity_at INTEGER notnull=1 default=NULL pk=0
  column 15 needs_attention INTEGER notnull=1 default=0 pk=0
  column 16 attention_reason TEXT notnull=0 default=NULL pk=0
  column 17 revision INTEGER notnull=1 default=NULL pk=0
  column 18 derived_version INTEGER notnull=1 default=NULL pk=0
  column 19 league_token TEXT notnull=0 default=NULL pk=0
  column 20 game_structure TEXT notnull=0 default=NULL pk=0
  column 21 games_won_imported INTEGER notnull=0 default=NULL pk=0
  column 22 games_lost_imported INTEGER notnull=0 default=NULL pk=0
  column 23 deck_version_id INTEGER notnull=0 default=NULL pk=0
  column 24 league_id INTEGER notnull=0 default=NULL pk=0
  column 25 tournament_id INTEGER notnull=0 default=NULL pk=0
  column 26 tournament_token TEXT notnull=0 default=NULL pk=0
  column 27 registered_deck_checked_at INTEGER notnull=0 default=NULL pk=0
  column 28 detached_at INTEGER notnull=0 default=NULL pk=0
  column 29 archetypes_detected_at INTEGER notnull=0 default=NULL pk=0
  column 30 games_synced_at INTEGER notnull=0 default=NULL pk=0
  column 31 opponent_archetype_none INTEGER notnull=1 default=0 pk=0
  column 32 league_linked INTEGER notnull=1 default=0 pk=0
  column 33 notes TEXT notnull=0 default=NULL pk=0
  column 34 hidden_at INTEGER notnull=0 default=NULL pk=0
  column 35 replay_share_uuid TEXT notnull=0 default=NULL pk=0
  column 36 replay_share_url TEXT notnull=0 default=NULL pk=0
  column 37 replay_shared_at INTEGER notnull=0 default=NULL pk=0
  column 38 legacy_history INTEGER notnull=1 default=0 pk=0
  column 39 no_league INTEGER notnull=1 default=0 pk=0
  column 40 edited_at INTEGER notnull=0 default=NULL pk=0
  column 41 deleted_from_league_id INTEGER notnull=0 default=NULL pk=0
  column 42 corrected_at INTEGER notnull=0 default=NULL pk=0
  column 43 history_outcome TEXT notnull=0 default=NULL pk=0
  column 44 rank_file_id INTEGER notnull=0 default=NULL pk=0
  column 45 rank_byte_offset INTEGER notnull=0 default=NULL pk=0
  check ((replay_share_uuid IS NULL) = (replay_share_url IS NULL) AND (replay_share_uuid IS NULL) = (replay_shared_at IS NULL))
  check (history_outcome IS NULL OR history_outcome IN ('win', 'loss'))
  check (league_linked IN (0, 1) AND (league_linked = 0 OR league_id IS NOT NULL))
  check (legacy_history = 0 OR source IN ('imported', 'history'))
  check (legacy_history IN (0, 1))
  check (needs_attention IN (0, 1))
  check (no_league IN (0, 1))
  check (notes IS NULL OR length(notes) BETWEEN 1 AND 5000)
  check (opponent_archetype_none IN (0, 1))
  check (outcome IN ('win', 'loss', 'draw', 'unknown'))
  check (source <> 'manual' OR mtgo_match_id IS NULL)
  check (source IN ('log', 'imported', 'manual', 'history'))
  check (state IN ('pending', 'in_progress', 'ended', 'complete', 'abandoned'))
  foreign key (account_id) -> accounts (id) on update NO ACTION on delete RESTRICT match NONE
  foreign key (deck_version_id) -> deck_versions (id) on update NO ACTION on delete SET NULL match NONE
  foreign key (deleted_from_league_id) -> leagues (id) on update NO ACTION on delete SET NULL match NONE
  foreign key (league_id) -> leagues (id) on update NO ACTION on delete SET NULL match NONE
  foreign key (opponent_id) -> opponents (id) on update NO ACTION on delete RESTRICT match NONE
  foreign key (tournament_id) -> tournaments (id) on update NO ACTION on delete SET NULL match NONE
  index matches_account_format_started unique=0 origin=c partial=1 on (account_id, format, started_at): CREATE INDEX matches_account_format_started ON matches (account_id, format, started_at) WHERE deck_version_id IS NOT NULL
  index matches_account_league unique=0 origin=c partial=1 on (account_id, league_token): CREATE INDEX matches_account_league ON matches (account_id, league_token) WHERE league_token IS NOT NULL
  index matches_account_tournament unique=0 origin=c partial=1 on (account_id, tournament_event_id): CREATE INDEX matches_account_tournament ON matches (account_id, tournament_event_id) WHERE tournament_event_id IS NOT NULL
  index matches_deck_version_id unique=0 origin=c partial=1 on (deck_version_id): CREATE INDEX matches_deck_version_id ON matches (deck_version_id) WHERE deck_version_id IS NOT NULL
  index matches_detect_due unique=0 origin=c partial=1 on (started_at): CREATE INDEX matches_detect_due ON matches (started_at) WHERE archetypes_detected_at IS NULL AND state = 'complete'
  index matches_league_id unique=0 origin=c partial=1 on (league_id): CREATE INDEX matches_league_id ON matches (league_id) WHERE league_id IS NOT NULL
  index matches_mtgo_match_id unique=0 origin=c partial=1 on (mtgo_match_id): CREATE INDEX matches_mtgo_match_id ON matches (mtgo_match_id) WHERE mtgo_match_id IS NOT NULL
  index matches_opponent_id unique=0 origin=c partial=1 on (opponent_id): CREATE INDEX matches_opponent_id ON matches (opponent_id) WHERE opponent_id IS NOT NULL
  index matches_started_at unique=0 origin=c partial=0 on (started_at): CREATE INDEX matches_started_at ON matches (started_at)
  index matches_tournament_id unique=0 origin=c partial=1 on (tournament_id): CREATE INDEX matches_tournament_id ON matches (tournament_id) WHERE tournament_id IS NOT NULL
  index sqlite_autoindex_matches_1 unique=1 origin=u partial=0 on (token)
trigger matches_hidden_records_league: CREATE TRIGGER matches_hidden_records_league AFTER UPDATE OF hidden_at ON matches WHEN OLD.hidden_at IS NULL AND NEW.hidden_at IS NOT NULL BEGIN UPDATE matches SET deleted_from_league_id = NEW.league_id WHERE id = NEW.id; END
trigger matches_hidden_relinked_records_league: CREATE TRIGGER matches_hidden_relinked_records_league AFTER UPDATE OF league_id ON matches WHEN NEW.hidden_at IS NOT NULL AND NEW.league_id IS NOT NULL AND NEW.league_id IS NOT OLD.league_id BEGIN UPDATE matches SET deleted_from_league_id = NEW.league_id WHERE id = NEW.id; END
trigger matches_inserted_hidden_records_league: CREATE TRIGGER matches_inserted_hidden_records_league AFTER INSERT ON matches WHEN NEW.hidden_at IS NOT NULL BEGIN UPDATE matches SET deleted_from_league_id = NEW.league_id WHERE id = NEW.id; END
trigger matches_league_changed_requeues_report: CREATE TRIGGER matches_league_changed_requeues_report AFTER UPDATE OF league_id ON matches WHEN OLD.league_id IS NOT NEW.league_id AND NEW.hidden_at IS NULL BEGIN DELETE FROM outbox WHERE kind = 'match_report' AND subject = NEW.token AND (status <> 'sent' OR attempts > 0); END
trigger matches_restored_clears_league: CREATE TRIGGER matches_restored_clears_league AFTER UPDATE OF hidden_at ON matches WHEN OLD.hidden_at IS NOT NULL AND NEW.hidden_at IS NULL BEGIN UPDATE matches SET deleted_from_league_id = NULL WHERE id = NEW.id; END
table opponents strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 username TEXT notnull=1 default=NULL pk=0
  column 2 first_seen_at INTEGER notnull=1 default=NULL pk=0
  column 3 platform TEXT notnull=1 default='mtgo' pk=0
  column 4 display_name TEXT notnull=0 default=NULL pk=0
  check (platform IN ('mtgo', 'arena', 'endstep'))
  index sqlite_autoindex_opponents_1 unique=1 origin=u partial=0 on (username)
table outbox strict=1 without_rowid=0
  column 0 id INTEGER notnull=0 default=NULL pk=1
  column 1 kind TEXT notnull=1 default=NULL pk=0
  column 2 subject TEXT notnull=1 default=NULL pk=0
  column 3 payload BLOB notnull=1 default=NULL pk=0
  column 4 status TEXT notnull=1 default=NULL pk=0
  column 5 attempts INTEGER notnull=1 default=0 pk=0
  column 6 next_attempt_at INTEGER notnull=0 default=NULL pk=0
  column 7 claimed_at INTEGER notnull=0 default=NULL pk=0
  column 8 last_error TEXT notnull=0 default=NULL pk=0
  column 9 sent_at INTEGER notnull=0 default=NULL pk=0
  column 10 created_at INTEGER notnull=1 default=NULL pk=0
  check ((status = 'sending') = (claimed_at IS NOT NULL))
  check ((status = 'sent') = (sent_at IS NOT NULL))
  check (kind IN ('match_report', 'tournament_observation', 'card_stats'))
  check (status IN ('pending', 'sending', 'sent', 'failed', 'skipped'))
  index outbox_due unique=0 origin=c partial=1 on (kind, created_at): CREATE INDEX outbox_due ON outbox (kind, created_at) WHERE status = 'pending'
  index sqlite_autoindex_outbox_1 unique=1 origin=u partial=0 on (kind, subject)
